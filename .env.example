# ─── LectureFlow Environment Variables ───────────────────────────────────────
#
# Copy this file to .env.local and fill in your API keys.
#
# Supadata — YouTube transcript extraction
# Get your API key at: https://supadata.ai/
SUPADATA_API_KEY=

# Groq — LLM inference
# Get your API key at: https://console.groq.com/
GROQ_API_KEY=

# Model configuration (defaults shown)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Maximum video duration in seconds (default: 5400 = 90 minutes)
MAX_VIDEO_DURATION_SECONDS=5400
